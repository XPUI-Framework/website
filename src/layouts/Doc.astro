---
import type { MarkdownHeading } from 'astro';
import PrevNext from '../components/PrevNext.astro';
import Sidebar from '../components/Sidebar.astro';
import EditLink from '../components/EditLink.astro';
import Toc from '../components/Toc.astro';
import type { SidebarGroup } from '../lib/docs.ts';
import type { NavPage } from '../lib/nav.ts';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  group: string;
  current: string;
  groups: SidebarGroup[];
  headings: MarkdownHeading[];
  previous?: NavPage;
  next?: NavPage;
  source: { github: string; edit: string };
}

const { title, description, group, current, groups, headings, previous, next, source } = Astro.props;
const hasToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length > 1;
---

<Base title={title} description={description}>
  <Sidebar slot="menu" groups={groups} current={current} />
  <div class="page doc">
    <article>
      {group && <p class="eyebrow">{group}</p>}
      {hasToc && (
        <details class="toc-inline">
          <summary>On this page</summary>
          <Toc headings={headings} />
        </details>
      )}
      <div class="prose"><slot /></div>
      <EditLink edit={source.edit} github={source.github} />
      <PrevNext previous={previous} next={next} />
    </article>
    <aside class="side"><Sidebar groups={groups} current={current} /></aside>
    {hasToc && (
      <aside class="toc-side" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <Toc headings={headings} />
      </aside>
    )}
  </div>
</Base>

<style>
  .doc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: 2rem 1rem;
  }

  .side, .toc-side { display: none; }

  article { min-width: 0; }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--ink-soft);
    font: 500 0.6875rem var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .toc-inline { margin-bottom: 1.75rem; padding: 0 1rem; border-radius: var(--radius-m); background: var(--tint); }

  .toc-inline summary {
    display: flex;
    align-items: center;
    min-height: var(--touch);
    font: 0.8125rem var(--font-mono);
    cursor: pointer;
    gap: 1rem;
  }

  .toc-inline[open] { padding-bottom: 0.75rem; }

  /* The article comes first in the markup, so a reader without CSS meets the page before the sidebar. */
  @media (min-width: 48rem) {
    .doc { grid-template-columns: 15rem minmax(0, 1fr); }
    article { grid-column: 2; grid-row: 1; }
    .side {
      grid-column: 1;
      grid-row: 1;
      display: block;
      position: sticky;
      top: 1rem;
      align-self: start;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
    }
  }

  @media (min-width: 75rem) {
    .doc { grid-template-columns: 15rem minmax(0, 1fr) 14rem; }
    .toc-inline { display: none; }
    .toc-side {
      grid-column: 3;
      grid-row: 1;
      display: block;
      position: sticky;
      top: 1rem;
      align-self: start;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
    }
  }
</style>
