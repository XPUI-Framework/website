---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const sections = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{sections.length > 1 && (
  <ul class="toc">
    {sections.map((h) => (
      <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
    ))}
  </ul>
)}

<style>
  .toc { margin: 0; padding: 0; list-style: none; font-size: 0.875rem; }

  a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.75rem;
    border-left: 2px solid transparent;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 120ms ease, border-color 120ms ease;
  }

  a:hover { color: var(--ink); }

  a[aria-current] { border-left-color: var(--ink); color: var(--ink); font-weight: 500; }

  .depth-3 a { padding-left: 1.625rem; }
</style>
