---
import Icon from './kit/Icon.astro';

interface Props {
  edit: string;
  github: string;
}

const { edit, github } = Astro.props;
---

<p class="edit">
  <a href={edit}>Edit this page on GitHub<Icon name="external" /></a>
  <span>It lives in <code>{github}</code>; a correction goes there.</span>
</p>

<style>
  .edit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    font-family: var(--font-mono);
    font-weight: 500;
    text-decoration: none;
  }

  a :global(.icon) { color: var(--ink-faint); }

  a:hover :global(.icon) { color: var(--ink); }

  span { color: var(--ink-soft); }
</style>
