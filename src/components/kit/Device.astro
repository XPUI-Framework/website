---
import { galleryImage } from '../../images.ts';

interface Props {
  /** A golden from xpui-gallery, 528 × 792, the X3's panel. */
  screen: string;
  alt: string;
  lazy?: boolean;
}

/**
 * The Xteink X3, photographed by Xteink, masked so its screen is a hole. A golden sits behind
 * the hole at half a CSS pixel per panel pixel; the frame's own proportions do the rest.
 */
const FRAME = { width: 561, screen: { width: 451, height: 677, left: 54, top: 50 } };
const PANEL = { width: 528, height: 792 };
const SCALE = 0.5;
const percent = (part: number, whole: number) => `${((part / whole) * 100).toFixed(4)}%`;

const { screen, alt, lazy = false } = Astro.props;
---

<figure
  class="device"
  style={`--screen:${PANEL.width * SCALE}px;--frame:${FRAME.width};--screen-width:${FRAME.screen.width};--left:${percent(FRAME.screen.left, FRAME.width)};--top:${percent(FRAME.screen.top, 849)};--width:${percent(FRAME.screen.width, FRAME.width)};--height:${percent(FRAME.screen.height, 849)}`}
>
  <span class="panel">
    <img src={galleryImage(screen)} width={PANEL.width} height={PANEL.height} alt={alt} loading={lazy ? 'lazy' : undefined} decoding="async" />
  </span>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<style>
  .device {
    position: relative;
    flex: none;
    margin: 0;
    width: calc(var(--screen) * var(--frame) / var(--screen-width));
    max-width: 100%;
    aspect-ratio: 561 / 849;
    background: var(--device-frame) center / contain no-repeat;
  }

  /* The golden, as the panel shows it: ink on paper in both themes, behind the frame's cut-out. */
  .panel {
    position: absolute;
    left: var(--left);
    top: var(--top);
    width: var(--width);
    height: var(--height);
    isolation: isolate;
    background: var(--panel-paper);
    overflow: hidden;
  }

  img { display: block; width: 100%; height: 100%; }

  @media (resolution: 2dppx) {
    img { image-rendering: pixelated; }
  }

  @supports (mix-blend-mode: multiply) {
    img { mix-blend-mode: multiply; }

    .panel::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--panel-ink);
      mix-blend-mode: lighten;
      pointer-events: none;
    }
  }

  figcaption {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 1rem;
    color: var(--ink-soft);
    font: 0.8125rem var(--font-mono);
    text-align: center;
  }
</style>
