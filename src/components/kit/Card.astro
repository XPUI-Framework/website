---
interface Props {
  href?: string;
}

const { href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['card', { link: href }]} href={href}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--paper);
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  /*
   * The border is there at rest, so hovering changes its colour and nothing moves. A card whose
   * title covers it answers the pointer anywhere on it — over the title, the text, or a link
   * that sits above the title's own reach.
   */
  .link:hover, .card:has(.stretched):hover { border-color: var(--ink-faint); background: var(--tint); }

  /* A link that covers its card, so the whole card answers the pointer. */
  .card :global(.stretched)::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }

  .card:has(.stretched):hover :global(.icon) { color: var(--ink); transform: translateX(2px); }
</style>
