---
import Card from './kit/Card.astro';
import Icon from './kit/Icon.astro';

interface Props {
  cards: { title: string; pages: { href: string; label: string; summary: string }[] }[];
  /** How narrow a column may be before the grid drops one, in rem. */
  column?: number;
}

const { cards, column = 18 } = Astro.props;
---

<div class="paths" style={`--column:${column}rem`}>
  {cards.map(({ title, pages }) => (
    <Card>
      <h3>{title}</h3>
      <ul>
        {pages.map((page) => (
          <li>
            <a href={page.href}>
              <span class="label">{page.label}<Icon name="arrow" /></span>
              <span class="summary">{page.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </Card>
  ))}
</div>

<style>
  .paths { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--column)), 1fr)); }

  h3 {
    margin: 0 0 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }

  a {
    display: grid;
    gap: 0.3rem;
    margin-inline: -0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-m);
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  a:hover { background: var(--tint); }

  .label { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; font: 600 0.9375rem var(--font-mono); }

  .label :global(.icon) { color: var(--ink-faint); transition: transform 150ms ease; }

  a:hover .label :global(.icon) { color: var(--ink); transform: translateX(2px); }

  .summary { color: var(--ink-soft); font-size: 0.875rem; line-height: 1.5; }
</style>
