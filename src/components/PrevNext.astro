---
import type { NavPage } from '../lib/nav.ts';
import { routeOf } from '../lib/routes.ts';
import Card from './kit/Card.astro';

interface Props {
  previous?: NavPage;
  next?: NavPage;
}

const { previous, next } = Astro.props;
---

<nav class="prevnext" aria-label="Previous and next">
  {previous && (
    <Card href={routeOf(previous.id)}>
      <span class="eyebrow">← Previous · {previous.group}</span>
      <span class="label">{previous.label}</span>
    </Card>
  )}
  {next && (
    <div class="next">
      <Card href={routeOf(next.id)}>
        <span class="eyebrow">Next · {next.group} →</span>
        <span class="label">{next.label}</span>
      </Card>
    </div>
  )}
</nav>

<style>
  .prevnext { display: grid; gap: 1rem; margin-top: 3.5rem; }

  @media (min-width: 40rem) {
    .prevnext { grid-template-columns: 1fr 1fr; }
    .next { grid-column: 2; text-align: right; }
  }

  .next :global(.card) { height: 100%; }

  .eyebrow { color: var(--ink-soft); font: 500 0.6875rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }

  .label { font: 600 1rem var(--font-mono); }
</style>
