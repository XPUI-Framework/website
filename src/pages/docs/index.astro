---
import { getCollection } from 'astro:content';
import DocPaths from '../../components/DocPaths.astro';
import Sidebar from '../../components/Sidebar.astro';
import Base from '../../layouts/Base.astro';
import { siteNav } from '../../lib/docs.ts';
import { readSite } from '../../lib/site.ts';
import { firstSentence } from '../../lib/sections.ts';

const { docs } = readSite();
const entries = await getCollection('docs');
const nav = siteNav(new Map(entries.map((e) => [e.id, e.body ?? ''])));
const summaries = new Map(entries.map((e) => [e.id, firstSentence(e.body ?? '')]));
---

<Base title={`${docs.title} · XPUI`} description={docs.lede}>
  <Sidebar slot="menu" groups={nav.groups} />
  <div class="page overview">
    <h1>{docs.title}</h1>
    <p class="lede">{docs.lede}</p>
    <DocPaths cards={nav.groups.map((group) => ({ title: group.label, pages: group.pages.map((page) => ({ ...page, summary: summaries.get(page.id) ?? '' })) }))} column={20} />
  </div>
</Base>

<style>
  .overview { padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem; }

  h1 { margin: 0 0 1rem; font-size: clamp(2rem, 5vw, 2.75rem); letter-spacing: -0.03em; }

  .lede { max-width: var(--measure); margin-bottom: 3rem; color: var(--ink-soft); font-size: 1.0625rem; }
</style>
